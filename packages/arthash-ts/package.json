{
  "name": "arthash",
  "version": "0.1.0",
  "description": "TypeScript SDK for arthash — wasm-backed encode/decode/toSvg.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jannchie/arthash.git",
    "directory": "packages/arthash-ts"
  },
  "homepage": "https://github.com/Jannchie/arthash",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm/pkg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --release --target web --out-dir pkg wasm",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "test": "vitest run",
    "lint": "echo 'lint not yet configured'"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
