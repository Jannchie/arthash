{
  "name": "arthash",
  "version": "0.1.2",
  "description": "TypeScript SDK for arthash — wasm-backed encode/decode/toSvg.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jannchie/arthash.git",
    "directory": "packages/arthash-ts"
  },
  "homepage": "https://github.com/Jannchie/arthash",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm/pkg",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm:cargo": "cargo build --release --target wasm32-unknown-unknown --manifest-path wasm/Cargo.toml",
    "build:wasm:bindgen": "wasm-bindgen --target web --out-dir wasm/pkg wasm/target/wasm32-unknown-unknown/release/arthash_wasm.wasm",
    "build:wasm:opt": "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int -o wasm/pkg/arthash_wasm_bg.wasm wasm/pkg/arthash_wasm_bg.wasm",
    "build:wasm": "pnpm run build:wasm:cargo && pnpm run build:wasm:bindgen && pnpm run build:wasm:opt",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm run build:wasm && pnpm run build:ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "lint": "echo 'lint not yet configured'"
  },
  "devDependencies": {
    "binaryen": "^129.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
