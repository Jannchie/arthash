{
  "version": "1.0",
  "description": "Cross-language conformance vectors for arthash. All SDKs (Python / TypeScript / Rust) must produce `expected_hex` exactly for each (input, codec, encode_kwargs).",
  "input_kinds": {
    "solid": "Solid color fill: H\u00d7W\u00d73 uint8 with arr[..., :] = rgb",
    "gradient": "Horizontal R gradient + vertical G gradient + constant B(=64). arr[y, x] = (linspace(0,255,W)[x], linspace(0,255,H)[y], 64).",
    "random": "Pseudo-random uint8 RGB seeded with numpy default_rng(seed). Pixels: (rng.random((H, W, 3)) * 255).astype(uint8). Non-Python SDKs must replicate numpy's PCG64 sequence; if that's impractical, skip the 'random' inputs and exercise only solid/gradient."
  },
  "vectors": [
    {
      "name": "dct-solid-red-100x100",
      "input": {
        "kind": "solid",
        "h": 100,
        "w": 100,
        "rgb": [
          255,
          0,
          0
        ]
      },
      "codec": {
        "shape": "dct",
        "n_shapes": 12,
        "cx_bits": 5,
        "cy_bits": 5,
        "r_bits": 4,
        "alpha_bits": 3,
        "color_bits": 16
      },
      "encode_kwargs": {
        "target_size": 100
      },
      "expected_hex": "e8af037f0088888888888888888888888888888888888808",
      "expected_bytes": 24
    },
    {
      "name": "dct-solid-blue-100x60",
      "input": {
        "kind": "solid",
        "h": 60,
        "w": 100,
        "rgb": [
          0,
          0,
          255
        ]
      },
      "codec": {
        "shape": "dct",
        "n_shapes": 12,
        "cx_bits": 5,
        "cy_bits": 5,
        "r_bits": 4,
        "alpha_bits": 3,
        "color_bits": 16
      },
      "encode_kwargs": {
        "target_size": 100
      },
      "expected_hex": "1c04009e008888888888888888888888888888",
      "expected_bytes": 19
    },
    {
      "name": "dct-gradient-100x60",
      "input": {
        "kind": "gradient",
        "h": 60,
        "w": 100
      },
      "codec": {
        "shape": "dct",
        "n_shapes": 12,
        "cx_bits": 5,
        "cy_bits": 5,
        "r_bits": 4,
        "alpha_bits": 3,
        "color_bits": 16
      },
      "encode_kwargs": {
        "target_size": 100
      },
      "expected_hex": "6765139e37938787517778797776926e390964",
      "expected_bytes": 19
    },
    {
      "name": "dct-random-seed42-96x64",
      "input": {
        "kind": "random",
        "h": 96,
        "w": 64,
        "seed": 42
      },
      "codec": {
        "shape": "dct",
        "n_shapes": 12,
