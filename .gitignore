# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/

# uv: commit lockfile + python-version for reproducibility
# (uncomment to drop them — see https://docs.astral.sh/uv/concepts/projects/sync/)

# IDE
.idea/
.vscode/

# Node / pnpm
node_modules/
.pnpm-store/

# Rust
target/

# wasm-pack output (regenerated; checked into npm publish, not git)
packages/arthash-ts/wasm/pkg/

# Compiled binaries
*.exe
*.pdb

# TypeScript incremental build cache
*.tsbuildinfo

# Research / R&D code (local-only)
packages/arthash-research/research/
!packages/arthash-research/research/corpus/README.md

# Bench scratch outputs
bench/sqip/tmp.*
bench/sqip/out.*

# harness outputs
packages/arthash-research/results/
*.csv

# Hill-climb bench outputs — reproducible from `cargo run --release
# --example bench_hillclimb`, so they stay out of git.
bench/hillclimb-*.ndjson

# Windows shell crash dumps
*.stackdump
